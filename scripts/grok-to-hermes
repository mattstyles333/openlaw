#!/usr/bin/env python3
"""Convert a Grok Bot freeze-export markdown folder into Hermes excerpts.

Input is a freeze-export folder of named .md files (00-FREEZE.md, README.md,
grok-bot/{roster,skills,routines,memory,computer}, herdr/, hermes/, snapshots).
Not a JSON dump. Not a required SOUL.md/instructions.md.

Always-on law in git markdown. Not MEMORY.md.
Does not write law/, AGENTS.md, MEMORY.md, memories/, or the repo root.
"""

from __future__ import annotations

import re
import shutil
import subprocess
import sys
from pathlib import Path

SECRET_LINE = re.compile(
    r"API_KEY=|BEGIN RSA PRIVATE KEY|sk-live-|ghp_|gho_|password:",
    re.I,
)
SLUG_KEEP = re.compile(r"[^a-z0-9]+")
SKIP_SKILL_STEMS = {
    "00-freeze",
    "architecture",
    "computer",
    "contact",
    "decisions",
    "freeze",
    "in-flight",
    "inflight",
    "memory",
    "openlaw",
    "openlaw-status",
    "readme",
    "roster",
    "routines",
    "secrets",
    "secrets-redacted",
    "sessions",
}
SKIP_SKILL_SUBSTR = (
    "secret",
    "in-flight",
    "inflight",
    "snapshot",
)
IDENTITY_REL = (
    "grok-bot/roster.md",
    "README.md",
    "00-FREEZE.md",
    "SOUL.md",
    "instructions.md",
)


def fail(msg: str) -> None:
    print(f"FAIL: {msg}", file=sys.stderr)
    raise SystemExit(1)


def note(msg: str) -> None:
    print(f"note: {msg}", file=sys.stderr)


def warn(msg: str) -> None:
    print(f"warn: {msg}", file=sys.stderr)


def find_root() -> Path:
    here = Path(__file__).resolve().parent.parent
    if (here / "AGENTS.md").is_file() and (here / "law").is_dir():
        return here
    fail("cannot find Openlaw repo root (need AGENTS.md + law/)")
    raise AssertionError


def usage() -> None:
    print(
        "Usage: bash scripts/openlaw grok-to-hermes <export-folder> <out-dir>\n"
        "\n"
        "Reads a Grok Bot freeze-export markdown folder (00-FREEZE.md,\n"
        "README.md, grok-bot/roster.md, grok-bot/skills.md, skills/, …).\n"
        "Writes Hermes SOUL.md and skills/<slug>/SKILL.md with YAML-safe\n"
        "frontmatter. Does not write MEMORY.md, memories/, law/, AGENTS.md,\n"
        "or the repo root. Snapshots and secrets-redacted.md are skipped.\n"
        "Routines and marketplace plugins are not mapped.",
        file=sys.stderr,
    )


def slugify(name: str) -> str:
    return SLUG_KEEP.sub("-", name.strip().lower()).strip("-")


def yaml_single_quote(value: str) -> str:
    return "'" + value.replace("'", "''") + "'"


def strip_frontmatter(text: str) -> str:
    body = text.replace("\r\n", "\n")
    if not body.startswith("---"):
        return body
    rest = body[3:]
    if rest.startswith("\n"):
        rest = rest[1:]
    end = rest.find("\n---")
    if end == -1:
        return body
    return rest[end + 4 :].lstrip("\n")


def scrub(text: str) -> str:
    lines = []
    for line in strip_frontmatter(text).splitlines():
        if SECRET_LINE.search(line):
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def one_liner(text: str) -> str:
    for line in text.splitlines():
        s = line.strip().lstrip("#").strip()
        if s:
            return s[:120]
    return "Openlaw skill excerpt"


def heading_name(text: str, fallback: str) -> str:
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("#"):
            title = s.lstrip("#").strip()
            if title:
                return title
        elif s:
            break
    return fallback


def excerpt_soul(root: Path) -> str:
    script = root / "scripts" / "excerpt-soul.sh"
    proc = subprocess.run(
        ["bash", str(script)],
        cwd=root,
        check=True,
        capture_output=True,
        text=True,
    )
    return proc.stdout.strip()


def read_md(path: Path) -> str:
    return scrub(path.read_text(encoding="utf-8"))


def rel_to(export: Path, path: Path) -> str:
    try:
        return str(path.resolve().relative_to(export.resolve()))
    except ValueError:
        return path.name


def is_skip_skill(path: Path) -> bool:
    stem = path.stem.lower()
    name = path.name.lower()
    if stem in SKIP_SKILL_STEMS or name in {s + ".md" for s in SKIP_SKILL_STEMS}:
        return True
    if stem.startswith("frozen-") or stem.startswith("freeze"):
        return True
    for token in SKIP_SKILL_SUBSTR:
        if token in stem or token in name:
            return True
    return False


def _skill_from_file(path: Path, slug_source: str, origin: str) -> tuple[str, str, str, str]:
    body = read_md(path)
    if not body:
        fail(f"empty skill markdown: {origin}")
    name = heading_name(body, slug_source)
    desc = one_liner(body)
    return origin, name, desc, body


def is_registry_heading(title: str) -> bool:
    t = title.lower()
    return (
        "user-created" in t
        or "cursor-managed" in t
        or "plugin skills" in t
        or t.startswith("plugin skill")
    )


def is_registry_body(body: str) -> bool:
    """True when the section is a table or list of names, not skill prose."""
    lines = [ln.strip() for ln in body.splitlines() if ln.strip()]
    if not lines:
        return True
    table_lines = [ln for ln in lines if ln.startswith("|")]
    has_id_name = any(
        re.search(r"\|\s*id\s*\|", ln, re.I) or re.search(r"\|\s*name\s*\|", ln, re.I)
        for ln in table_lines
    )
    bullets = [ln for ln in lines if re.match(r"^([-*+] |\d+\. )", ln)]
    prose_bits = []
    for ln in lines:
        if ln.startswith("|") or re.match(r"^[:|\-\s]+$", ln):
            continue
        if re.match(r"^([-*+] |\d+\. )", ln):
            continue
        prose_bits.append(ln)
    prose = " ".join(prose_bits)
    sentences = [
        s.strip()
        for s in re.split(r"[.!?]+", prose)
        if len(s.strip()) > 10
    ]
    if len(sentences) >= 2:
        return False
    if has_id_name:
        return True
    if table_lines and len(table_lines) >= max(2, len(lines) // 2):
        return True
    if bullets and len(bullets) >= max(1, len(lines) // 2):
        return True
    return False


def skills_from_catalog(path: Path, origin: str) -> list[tuple[str, str, str, str]]:
    text = read_md(path)
    if not text:
        fail(f"empty skill markdown: {origin}")
    chunks = re.split(r"(?m)^## ", text)
    rest = chunks[1:]
    if not rest:
        name = heading_name(text, path.stem)
        intro = chunks[0] if chunks else text
        if is_registry_heading(name) or is_registry_body(intro):
            note(f"skipping {origin} (registry, not a skill body)")
            return []
        return [(origin, name, one_liner(text), text)]
    out: list[tuple[str, str, str, str]] = []
    for chunk in rest:
        lines = chunk.splitlines()
        title = lines[0].strip()
        body = "\n".join(lines[1:]).strip()
        if is_registry_heading(title) or is_registry_body(body):
            note(
                f"skipping {origin} section {title!r} (registry, not a skill body)"
            )
            continue
        content = f"# {title}\n"
        if body:
            content += f"\n{body}"
        out.append(
            (f"{origin}##{title}", title, one_liner(content), content.strip() + "\n")
        )
    return out


_MEMORY_DROP = ("session", "log", "recall", "dump", "transcript", "today", "diary")


def _memory_title_core(title: str) -> str:
    return re.sub(r"\([^)]*\)", "", title).strip().lower()


def is_durable_memory_section(title: str) -> bool:
    raw = title.strip().lower()
    core = _memory_title_core(title)
    if any(w in raw for w in _MEMORY_DROP):
        return False
    if any(w in raw for w in ("durable", "convention", "profile", "identity")):
        return True
    if core.startswith("org") or core.startswith("process"):
        return True
    if core.startswith("clock") or core.startswith("people"):
        return True
    return False


def parse_memory_md(text: str, origin: str) -> list[str]:
    folded: list[str] = []
    current: str | None = None
    saw_heading = False
    for line in text.splitlines():
        if re.match(r"^##\s+", line):
            saw_heading = True
            title = line.lstrip("#").strip()
            if is_durable_memory_section(title):
                current = "durable"
            else:
                current = "drop"
                note(
                    f"ignoring {origin} section {line.strip()!r} (not durable conventions)"
                )
            continue
        if current == "durable":
            item = line.strip().lstrip("-").strip()
            if item:
                folded.append(item)
    if not saw_heading:
        note(f"ignoring {origin} (no Durable conventions section)")
        return []
    return folded


def collect_skills_dir(
    skills_dir: Path, export: Path
) -> list[tuple[str, str, str, str]]:
    skills: list[tuple[str, str, str, str]] = []
    if not skills_dir.is_dir():
        return skills
    for path in sorted(skills_dir.iterdir()):
        if path.name.startswith("."):
            continue
        origin = rel_to(export, path)
        if path.is_dir():
            skill_md = path / "SKILL.md"
            if skill_md.is_file():
                if is_skip_skill(path):
                    note(f"skipping {origin}/SKILL.md (snapshot/secrets)")
                else:
                    skills.append(
                        _skill_from_file(skill_md, path.name, f"{origin}/SKILL.md")
                    )
            else:
                note(f"ignoring {origin}/ (no SKILL.md)")
            continue
        if path.suffix.lower() != ".md":
            note(f"ignoring {origin} (not markdown)")
            continue
        if is_skip_skill(path):
            note(f"skipping {origin} (snapshot/secrets)")
            continue
        skills.append(_skill_from_file(path, path.stem, origin))
    return skills


def collect_export(
    export: Path,
) -> tuple[str, list[tuple[str, str, str, str]], list[str]]:
    identity_parts: list[str] = []
    seen_identity: set[Path] = set()
    for rel in IDENTITY_REL:
        path = export / rel
        if path.is_file():
            identity_parts.append(read_md(path))
            seen_identity.add(path.resolve())
    if not identity_parts:
        fail(
            "no identity markdown (need grok-bot/roster.md, README.md, "
            "00-FREEZE.md, or similar)"
        )

    skills: list[tuple[str, str, str, str]] = []
    catalog = export / "grok-bot" / "skills.md"
    if catalog.is_file():
        skills.extend(skills_from_catalog(catalog, "grok-bot/skills.md"))
    skills.extend(collect_skills_dir(export / "skills", export))
    skills.extend(collect_skills_dir(export / "grok-bot" / "skills", export))

    conventions: list[str] = []
    memory_path = export / "grok-bot" / "memory.md"
    if memory_path.is_file():
        conventions = parse_memory_md(read_md(memory_path), "grok-bot/memory.md")
    root_memory = export / "memory.md"
    if root_memory.is_file():
        note("ignoring memory.md (use grok-bot/memory.md)")

    for path in sorted(export.rglob("*")):
        if path.name.startswith(".") or not path.is_file():
            continue
        resolved = path.resolve()
        if resolved in seen_identity:
            continue
        origin = rel_to(export, path)
        if origin in {"grok-bot/skills.md", "grok-bot/memory.md"}:
            continue
        if path.suffix.lower() != ".md":
            note(f"ignoring {origin} (unknown artifact)")
            continue
        parent_names = {p.name.lower() for p in path.parents}
        under_skills = "skills" in parent_names
        if under_skills:
            continue
        if is_skip_skill(path) or origin.split("/")[0].lower() in {
            "herdr",
            "hermes",
        }:
            note(f"skipping {origin} (snapshot/secrets)")
            continue
        if path.parent.resolve() == (export / "grok-bot").resolve() and path.name.lower() in {
            "routines.md",
            "computer.md",
            "memory.md",
            "roster.md",
            "skills.md",
        }:
            if path.name.lower() not in {"roster.md", "skills.md", "memory.md"}:
                note(f"skipping {origin} (not mapped)")
            continue
        note(f"ignoring {origin} (not a skill source)")

    return "\n\n".join(p for p in identity_parts if p), skills, conventions


def resolve_slugs(
    skills: list[tuple[str, str, str, str]],
) -> list[tuple[str, str, str]]:
    grouped: dict[str, list[tuple[str, str, str, str]]] = {}
    for origin, name, desc, body in skills:
        slug = slugify(name)
        if not slug:
            fail(f"all-punctuation name cannot slugify: {origin}")
        grouped.setdefault(slug, []).append((origin, name, desc, body))
    collisions = {slug: items for slug, items in grouped.items() if len(items) > 1}
    if collisions:
        parts = []
        for slug, items in collisions.items():
            names = ", ".join(f"{origin} ({name})" for origin, name, _, _ in items)
            parts.append(f"{slug!r}: {names}")
        fail("slug collision " + "; ".join(parts))
    out: list[tuple[str, str, str]] = []
    for slug, items in grouped.items():
        _origin, _name, desc, body = items[0]
        out.append((slug, desc, body))
    return out


def build_soul(root: Path, identity: str, conventions: list[str]) -> str:
    parts = []
    if identity:
        parts.append(identity)
        parts.append("")
    parts.append(excerpt_soul(root))
    if conventions:
        parts.extend(["", "## Durable conventions", ""])
        for line in conventions:
            parts.append(f"- {line}")
    parts.append("")
    parts.append(
        "Do not treat MEMORY.md or memories/ as law. Retrieval is not law."
    )
    return "\n".join(parts).rstrip() + "\n"


def skill_file(slug: str, description: str, body: str) -> str:
    desc = description.strip() or "Openlaw skill excerpt"
    return (
        f"---\nname: {yaml_single_quote(slug)}\n"
        f"description: {yaml_single_quote(desc)}\n---\n\n{body.rstrip()}\n"
    )


def refuse_out_dir(root: Path, out: Path) -> None:
    if out.exists() and out.is_file():
        fail(f"out-dir is an existing file, not a directory: {out}")
    target = out.resolve()
    repo = root.resolve()
    law = (root / "law").resolve()
    agents = (root / "AGENTS.md").resolve()
    if target == agents:
        fail("refusing to write AGENTS.md")
    if target == repo:
        fail("refusing to write to the repository root")
    if target == law or law in target.parents or target.name == "law":
        fail("refusing to write under law/")
    if target.name in {"MEMORY.md", "memories"}:
        fail("refusing to write MEMORY.md / memories/ (recall is not law)")
    if "memories" in target.parts:
        fail("refusing to write under memories/")
    if "law" in target.parts and (repo / "law").resolve() in target.parents:
        fail("refusing to write under law/")


def prune_stale_skills(out: Path, keep: set[str]) -> None:
    skills_root = out / "skills"
    if not skills_root.is_dir():
        return
    existing = [
        p for p in skills_root.iterdir() if p.is_dir() and not p.name.startswith(".")
    ]
    if existing:
        warn("out-dir already has skills/; pruning stale slugs")
    for path in existing:
        if path.name not in keep:
            shutil.rmtree(path)
            warn(f"pruned out/skills/{path.name}/")


def write_tree(out: Path, soul: str, skills: list[tuple[str, str, str]]) -> list[str]:
    keep = {slug for slug, _, _ in skills}
    if out.exists() and not out.is_dir():
        fail(f"out-dir is an existing file, not a directory: {out}")
    out.mkdir(parents=True, exist_ok=True)
    prune_stale_skills(out, keep)
    wrote: list[str] = []
    soul_path = out / "SOUL.md"
    soul_path.write_text(soul, encoding="utf-8")
    wrote.append(str(soul_path))
    for slug, desc, body in skills:
        if slug in {"secrets-redacted", "secrets"}:
            fail(f"refusing to emit skills/{slug}/")
        skill_dir = out / "skills" / slug
        skill_dir.mkdir(parents=True, exist_ok=True)
        path = skill_dir / "SKILL.md"
        path.write_text(skill_file(slug, desc, body), encoding="utf-8")
        wrote.append(str(path))
    return wrote


def main(argv: list[str]) -> int:
    if not argv or argv[0] in {"-h", "--help", "help"}:
        usage()
        return 0 if argv and argv[0] in {"-h", "--help", "help"} else 1
    if len(argv) != 2:
        usage()
        fail("need <export-folder> <out-dir>")
    export = Path(argv[0])
    out = Path(argv[1])
    if not export.exists():
        fail(f"missing export folder: {export}")
    if not export.is_dir():
        fail(f"input must be a markdown export folder, not a file: {export}")
    root = find_root()
    refuse_out_dir(root, out)
    identity, raw_skills, conventions = collect_export(export)
    skills = resolve_slugs(raw_skills)
    soul = build_soul(root, identity, conventions)
    wrote = write_tree(out, soul, skills)
    print(f"Openlaw grok-to-hermes: {root}")
    for path in wrote:
        try:
            rel = Path(path).resolve().relative_to(root)
        except ValueError:
            rel = Path(path)
        print(f"Wrote {rel}")
    print("Do not paste this into MEMORY.md. Retrieval is not law.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except SystemExit:
        raise
    except BrokenPipeError:
        raise SystemExit(0)
    except Exception as exc:
        print(f"FAIL: {exc}", file=sys.stderr)
        raise SystemExit(1)
