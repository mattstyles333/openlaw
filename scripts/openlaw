#!/usr/bin/env bash
# Thin Openlaw CLI for skills. Offline. Git markdown. Not a memory product.
#
# Skills call: bash scripts/openlaw <command>
# Commands: law | priorities | permissions | check | decisions | propose | help
#
# law          print constraints+brand+sor concatenated (same as MCP get_law). NOT search.
# priorities   print law/priorities.md
# permissions  print law/permissions.md
# check        run scripts/check-law.sh
# decisions    print decisions/20*.md from git. A proposed ADR is not binding.
# propose      wrap scripts/propose.sh (does not write law/ or AGENTS.md)
# help         this text
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bash scripts/openlaw <command>

Commands:
  law           print law/constraints.md + brand.md + sor.md (not search)
  priorities    print law/priorities.md
  permissions   print law/permissions.md
  check         run scripts/check-law.sh
  decisions     print decisions/20*.md from git (not binding)
  propose [slug]  copy decisions/_template.md via scripts/propose.sh
  help          this help

Offline. No HTTP. No secrets. Git is the source of truth.
A proposed ADR is not law until CODEOWNERS merge.
EOF
}

find_root() {
  local dir
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "$dir/AGENTS.md" && -d "$dir/law" ]]; then
    printf '%s\n' "$dir"
    return 0
  fi
  if dir="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    if [[ -f "$dir/AGENTS.md" && -d "$dir/law" ]]; then
      printf '%s\n' "$dir"
      return 0
    fi
  fi
  echo "FAIL: cannot find Openlaw repo root (need AGENTS.md + law/)" >&2
  exit 1
}

print_file() {
  local rel="$1"
  if [[ ! -f "$rel" ]]; then
    echo "FAIL: missing $rel" >&2
    exit 1
  fi
  cat "$rel"
}

cmd_law() {
  local name
  local first=1
  for name in constraints.md brand.md sor.md; do
    if [[ ! -f "law/$name" ]]; then
      echo "FAIL: missing law/$name" >&2
      exit 1
    fi
    if [[ $first -eq 0 ]]; then
      printf '\n---\n\n'
    fi
    first=0
    printf '<!-- law/%s -->\n' "$name"
    cat "law/$name"
  done
}

cmd_decisions() {
  shopt -s nullglob
  local files=(decisions/20*.md)
  shopt -u nullglob
  if [[ ${#files[@]} -eq 0 ]]; then
    echo "FAIL: no decisions/20*.md" >&2
    exit 1
  fi
  local first=1
  local f
  for f in "${files[@]}"; do
    if [[ $first -eq 0 ]]; then
      printf '\n---\n\n'
    fi
    first=0
    printf '<!-- %s -->\n' "$f"
    cat "$f"
  done
}

ROOT="$(find_root)"
cd "$ROOT"

cmd="${1:-help}"
case "$cmd" in
  -h|--help|help)
    usage
    ;;
  law)
    cmd_law
    ;;
  priorities)
    print_file law/priorities.md
    ;;
  permissions)
    print_file law/permissions.md
    ;;
  check)
    exec bash scripts/check-law.sh
    ;;
  decisions)
    cmd_decisions
    ;;
  propose)
    shift
    exec bash scripts/propose.sh "$@"
    ;;
  *)
    echo "FAIL: unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
