---
import { gatherOps } from '../../../scripts/gather-ops.mjs';
import '../../styles/ops.css';

const ops = gatherOps();
const base = import.meta.env.BASE_URL;
const docs = `${base}docs/`;
const snapshot = JSON.stringify(ops);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ops — Openlaw</title>
    <meta
      name="description"
      content="Build-time ops one-pager. CI health, harness matrix, open proposals. Generated from git markdown. No live database."
    />
    <link rel="icon" href={`${base}openlaw-mark.png`} type="image/png" />
  </head>
  <body class="min-h-screen bg-ink text-paper font-sans antialiased">
    <div class="mx-auto max-w-6xl px-6 py-10">
      <nav class="mb-10 flex flex-wrap items-baseline justify-between gap-4 border-b border-line pb-4 text-xs uppercase tracking-[0.16em]">
        <a class="inline-flex items-center gap-2 font-semibold text-paper no-underline" href={base}>
          <img src={`${base}openlaw-mark.png`} alt="" width="28" height="28" class="h-7 w-7 rounded" />
          Openlaw
        </a>
        <span class="flex flex-wrap gap-3 text-brass">
          <a class="hover:underline" href={docs}>Docs</a>
          <a class="hover:underline" href={`${docs}status/`}>Status</a>
          <a class="hover:underline" href="https://github.com/mattstyles333/openlaw">GitHub</a>
        </span>
      </nav>

      <header class="mb-10 grid gap-3">
        <p class="text-xs uppercase tracking-[0.16em] text-brass">Ops · build-time snapshot</p>
        <h1 class="text-4xl font-semibold tracking-tight">Git law, in one page</h1>
        <p class="max-w-2xl text-sm leading-6 text-mute">
          Autogenerated when the site builds. Reads markdown and workflow files in this
          checkout. No live database, no runtime fetch, no memory product.
        </p>
        <p class="text-xs text-mute">
          Generated at <time datetime={ops.generatedAt}>{ops.generatedAt}</time>
          {ops.siteVersion ? ` · site v${ops.siteVersion}` : ''}
          · liveDb={String(ops.liveDb)}
        </p>
      </header>

      <section class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-3">
        <article class="rounded-2xl border border-line bg-panel p-6">
          <p class="mb-2 text-xs uppercase tracking-[0.16em] text-brass">CI health</p>
          <p
            class="mb-3 text-2xl font-semibold"
            data-ops="ci-health-status"
          >
            {ops.ciHealth.healthy ? 'Gates present in git' : 'Gates missing in git'}
          </p>
          <p class="text-sm leading-6 text-mute" data-ops="ci-health-summary">
            {ops.ciHealth.summary}
          </p>
          <ul class="mt-4 grid gap-2 text-sm" data-ops="ci-health">
            {
              ops.ciHealth.workflows.map((wf) => (
                <li class="flex flex-wrap items-baseline justify-between gap-2 border-t border-line pt-2">
                  <span class="font-medium">{wf.name}</span>
                  <span class="text-xs text-mute">{wf.on.join(', ') || 'on: (none)'}</span>
                </li>
              ))
            }
          </ul>
        </article>

        <article class="rounded-2xl border border-line bg-panel p-6">
          <p class="mb-2 text-xs uppercase tracking-[0.16em] text-brass">Harness matrix</p>
          <p class="mb-3 text-2xl font-semibold" data-ops="harness-source">
            {ops.harness.source === 'permissions' ? 'From law/permissions.md' : 'Placeholder'}
          </p>
          <pre
            class="max-h-64 overflow-auto whitespace-pre-wrap text-xs leading-5 text-paper"
            data-ops="harness-summary"
          >{ops.harness.summary}</pre>
          {
            ops.harness.href ? (
              <a class="mt-3 inline-block text-sm text-brass hover:underline" href={ops.harness.href}>
                {ops.harness.path}
              </a>
            ) : (
              <p class="mt-3 text-xs text-mute">{ops.harness.path} is absent in this tree.</p>
            )
          }
        </article>

        <article class="rounded-2xl border border-line bg-panel p-6">
          <p class="mb-2 text-xs uppercase tracking-[0.16em] text-brass">Open proposals</p>
          <p class="mb-3 text-4xl font-semibold" data-ops="open-proposals-count">
            {ops.openProposals}
          </p>
          <p class="mb-4 text-sm text-mute">
            ADRs in <code class="text-paper">decisions/</code> with <code class="text-paper">status: proposed</code>.
          </p>
          <ul class="grid gap-2 text-sm" data-ops="open-proposals">
            {
              ops.proposals.length === 0 ? (
                <li class="text-mute">None in this checkout.</li>
              ) : (
                ops.proposals.map((item) => (
                  <li>
                    <a class="text-brass hover:underline" href={item.href}>
                      {item.path}
                    </a>
                  </li>
                ))
              )
            }
          </ul>
        </article>
      </section>

      <section class="rounded-2xl border border-line bg-panel p-6" data-ops="md-links">
        <h2 class="mb-4 text-xs uppercase tracking-[0.16em] text-brass">Markdown in git</h2>
        <p class="mb-4 max-w-2xl text-sm leading-6 text-mute">
          Source of truth is the working tree. These links go to the files on GitHub
          (<code class="text-paper">.md</code>), not a retrieved neighbour.
        </p>
        <ul class="grid grid-cols-1 gap-2 text-sm sm:grid-cols-2 md:grid-cols-3">
          {
            ops.markdownLinks.map((link) => (
              <li>
                <a class="text-brass hover:underline" href={link.href}>
                  {link.path}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="mt-10 text-xs text-mute">
        MIT · build-time only · not a memory SaaS
      </p>
    </div>
    <script id="ops-snapshot" type="application/json" set:html={snapshot} />
  </body>
</html>
